      "text": "E expire por um tempo mais longo.",
      "file": "c005.ogg",
      "durationSec": 4.8
    },
    {
      "index": 6,
      "text": "Vamos respirar em um quadrado simples.",
      "file": "c006.ogg",
      "durationSec": 5.424
    },
    {
      "index": 7,
      "text": "Inale por quatro. Segure por quatro. Exale por quatro. Segure por quatro.",
