    {
      "index": 35,
      "text": "[pausa:27]",
      "file": "c035.ogg",
      "durationSec": 4.128
    },
    {
      "index": 36,
      "text": "Sinta novamente a sala.",
      "file": "c036.ogg",
      "durationSec": 4.296
    },
    {
      "index": 37,
      "text": "Mova os dedos das mãos e dos pés.",
      "file": "c037.ogg",
      "durationSec": 5.352
    },
    {
      "index": 38,
      "text": "Quando estiver pronto, abra os olhos.",
      "file": "c038.ogg",
      "durationSec": 5.424
    },
    {
