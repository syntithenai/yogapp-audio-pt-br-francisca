    {
      "index": 7,
      "text": "[pausa:23]",
      "file": "c007.ogg",
      "durationSec": 3.888
    },
    {
      "index": 8,
      "text": "Novamente.",
      "file": "c008.ogg",
      "durationSec": 3.024
    },
    {
      "index": 9,
      "text": "[pausa:23]",
      "file": "c009.ogg",
      "durationSec": 3.888
    },
    {
      "index": 10,
      "text": "Deixe os ombros caírem.",
      "file": "c010.ogg",
      "durationSec": 4.008
    },
    {
      "index": 11,
      "text": "Deixe a barriga amolecer.",
