    {
      "index": 12,
      "text": "[pausa:29]",
      "file": "c012.ogg",
      "durationSec": 3.912
    },
    {
      "index": 13,
      "text": "Abra os ouvidos.",
      "file": "c013.ogg",
      "durationSec": 3.48
    },
    {
      "index": 14,
      "text": "Perceba o som mais próximo.",
      "file": "c014.ogg",
      "durationSec": 4.464
    },
    {
      "index": 15,
      "text": "[pausa:29]",
      "file": "c015.ogg",
      "durationSec": 3.912
    },
    {
      "index": 16,
      "text": "Perceba o som mais distante que você consegue ouvir.",
      "file": "c016.ogg",
      "durationSec": 6.552
    },
    {
      "index": 17,
      "text": "[pausa:29]",
      "file": "c017.ogg",
      "durationSec": 3.912
    },
    {
      "index": 18,
      "text": "Perceba o silêncio entre os sons.",
      "file": "c018.ogg",
      "durationSec": 4.8
    },
    {
      "index": 19,
      "text": "[pausa:35]",
      "file": "c019.ogg",
      "durationSec": 4.2
    },
    {
      "index": 20,
      "text": "Os sons surgem e passam. Você não precisa nomeá-los.",
      "file": "c020.ogg",
      "durationSec": 7.32
    },
    {
      "index": 21,
      "text": "O ouvir ouve.",
      "file": "c021.ogg",
      "durationSec": 3.12
    },
    {
      "index": 22,
      "text": "[pausa:47]",
      "file": "c022.ogg",
      "durationSec": 4.272
    },
    {
      "index": 23,
      "text": "Quando a mente se desviar, volte a ouvir.",
      "file": "c023.ogg",
      "durationSec": 5.496
    },
    {
      "index": 24,
      "text": "[pausa:35]",
      "file": "c024.ogg",
      "durationSec": 4.2
    },
    {
      "index": 25,
      "text": "Inclua o som da sua própria respiração.",
      "file": "c025.ogg",
      "durationSec": 5.64
    },
    {
      "index": 26,
      "text": "[pausa:35]",
      "file": "c026.ogg",
      "durationSec": 4.2
    },
    {
      "index": 27,
      "text": "Descanse na paisagem sonora inteira.",
      "file": "c027.ogg",
      "durationSec": 5.424
    },
    {
      "index": 28,
      "text": "Um campo vivo de vibração.",
