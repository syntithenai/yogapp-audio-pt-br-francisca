      "durationSec": 4.44
    },
    {
      "index": 29,
      "text": "[pausa:90]",
      "file": "c029.ogg",
      "durationSec": 3.6
    },
    {
      "index": 30,
      "text": "Nada a resolver no ouvir.",
      "file": "c030.ogg",
      "durationSec": 4.056
    },
    {
      "index": 31,
      "text": "[pausa:70]",
      "file": "c031.ogg",
