{
  "id": "bamboo-garden-10",
  "voiceId": "pt-br-francisca",
  "edgeVoice": "pt-BR-FranciscaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 621,
  "chunks": [
    {
      "index": 0,
      "text": "Bem-vindo.",
      "file": "c000.ogg",
      "durationSec": 2.832
    },
    {
      "index": 1,
      "text": "Encontre uma postura que não exija nada de você.",
      "file": "c001.ogg",
      "durationSec": 6.216
    },
    {
      "index": 2,
      "text": "Sente-se ou deite-se, com o apoio que precisar.",
      "file": "c002.ogg",
      "durationSec": 5.904
    },
    {
      "index": 3,
      "text": "Deixe as mãos repousar abertas ou relaxadas.",
      "file": "c003.ogg",
      "durationSec": 6.288
    },
    {
      "index": 4,
      "text": "Permita que seus olhos se fechem, ou mantenha um olhar suave.",
      "file": "c004.ogg",
      "durationSec": 7.656
    },
    {
      "index": 5,
      "text": "Sinta os pontos onde seu corpo encontra o chão.",
      "file": "c005.ogg",
      "durationSec": 6.408
    },
    {
      "index": 6,
      "text": "Os calcanhares, os ossos isquiáticos, a parte de trás da cabeça ou o comprimento da coluna.",
      "file": "c006.ogg",
      "durationSec": 11.064
    },
    {
      "index": 7,
      "text": "Nada para sustentar agora.",
      "file": "c007.ogg",
      "durationSec": 4.392
    },
    {
      "index": 8,
      "text": "Respire lentamente pelo nariz.",
      "file": "c008.ogg",
      "durationSec": 4.752
    },
    {
      "index": 9,
      "text": "Sinta a frescura do ar chegando.",
      "file": "c009.ogg",
      "durationSec": 4.944
    },
    {
      "index": 10,
      "text": "E expire um pouco mais longo.",
      "file": "c010.ogg",
      "durationSec": 3.936
    },
    {
      "index": 11,
      "text": "Sinta o calor da expiração saindo.",
      "file": "c011.ogg",
      "durationSec": 5.424
    },
    {
      "index": 12,
      "text": "Mais uma vez. Inalação suave.",
      "file": "c012.ogg",
      "durationSec": 5.712
    },
    {
      "index": 13,
      "text": "Exalação tranquila.",
      "file": "c013.ogg",
      "durationSec": 3.816
    },
    {
      "index": 14,
      "text": "Deixe os ombros baixarem um pouco.",
      "file": "c014.ogg",
      "durationSec": 5.112
    },
    {
      "index": 15,
      "text": "Relaxe a mandíbula.",
      "file": "c015.ogg",
      "durationSec": 3.768
    },
    {
      "index": 16,
      "text": "Deixe a barriga ser macia.",
      "file": "c016.ogg",
      "durationSec": 4.512
    },
    {
      "index": 17,
      "text": "Permaneça com três respirações tranquilas, exatamente como elas são.",
      "file": "c017.ogg",
      "durationSec": 8.88
    },
    {
      "index": 18,
      "text": "Inale. Chegue.",
      "file": "c018.ogg",
      "durationSec": 4.08
    },
    {
      "index": 19,
      "text": "Exale. Acomode-se.",
      "file": "c019.ogg",
      "durationSec": 4.536
    },
    {
      "index": 20,
      "text": "Se a mente se desviar, observe com gentileza e volte a esta respiração.",
      "file": "c020.ogg",
      "durationSec": 9.528
    },
    {
      "index": 21,
      "text": "Imagine um jardim de bambu após a chuva.",
      "file": "c021.ogg",
      "durationSec": 6.072
    },
    {
      "index": 22,
      "text": "A pedra é escura e limpa. As folhas brilham.",
      "file": "c022.ogg",
      "durationSec": 6.672
    },
    {
      "index": 23,
      "text": "Uma frescura suave enche o ar como um sino suave.",
      "file": "c023.ogg",
      "durationSec": 6.888
    },
    {
      "index": 24,
      "text": "Uma abertura nas nuvens deixa o sol passar.",
      "file": "c024.ogg",
      "durationSec": 5.736
    },
    {
      "index": 25,
      "text": "Sinta um calor suave e repentino na testa e nas maçãs do rosto.",
      "file": "c025.ogg",
      "durationSec": 8.304
    },
    {
      "index": 26,
      "text": "Um leve vapor sobe do caminho — a terra respirando.",
      "file": "c026.ogg",
      "durationSec": 6.864
    },
    {
      "index": 27,
      "text": "Você pisa em pedras de passagem cobertas de musgo.",
      "file": "c027.ogg",
      "durationSec": 6.744
    },
    {
      "index": 28,
      "text": "Cada pedra é fresca e firme sob os pés.",
      "file": "c028.ogg",
      "durationSec": 5.88
    },
    {
      "index": 29,
      "text": "O bambu range e sussurra com uma brisa leve.",
      "file": "c029.ogg",
      "durationSec": 6.048
    },
    {
      "index": 30,
      "text": "O som é verde. O som é calmo.",
      "file": "c030.ogg",
      "durationSec": 5.52
    },
    {
      "index": 31,
      "text": "Sinta o cheiro de folhas molhadas, pedra e uma leve doçura de plantas de chá nas proximidades.",
      "file": "c031.ogg",
      "durationSec": 11.52
    },
    {
      "index": 32,
      "text": "Pare ao lado de uma pequena lagoa.",
      "file": "c032.ogg",
      "durationSec": 4.752
    },
    {
      "index": 33,
      "text": "Os carpa movem-se como pensamentos lentos sob a superfície.",
      "file": "c033.ogg",
      "durationSec": 7.56
    },
    {
      "index": 34,
      "text": "Raios de sol aquecem seus pulsos enquanto você os apoia no parapeito.",
      "file": "c034.ogg",
      "durationSec": 8.688
    },
    {
      "index": 35,
      "text": "Uma brisa refresca a umidade em suas têmporas.",
      "file": "c035.ogg",
      "durationSec": 6.288
    },
    {
      "index": 36,
      "text": "Frescor dentro. Suavidade fora.",
      "file": "c036.ogg",
      "durationSec": 5.784
    },
    {
      "index": 37,
      "text": "Siga um caminho coberto de madeira desgastada.",
      "file": "c037.ogg",
      "durationSec": 6.504
    },
    {
      "index": 38,
      "text": "As tábuas estão frescas na sombra, mais quentes onde a luz cai.",
      "file": "c038.ogg",
      "durationSec": 7.92
    },
    {
      "index": 39,
      "text": "Você se senta em um banco de frente para cascalho raspado e uma pedra perfeita.",
      "file": "c039.ogg",
      "durationSec": 9.24
    },
    {
      "index": 40,
      "text": "Nada precisa ser reorganizado.",
      "file": "c040.ogg",
      "durationSec": 4.824
    },
    {
      "index": 41,
      "text": "Sinta a geometria tranquila acalmar sua mente.",
      "file": "c041.ogg",
      "durationSec": 6.552
    },
    {
      "index": 42,
      "text": "Aquecimento retorna à medida que a nuvem se espessa — uma mão gentil nos ombros.",
      "file": "c042.ogg",
      "durationSec": 9.528
    },
    {
      "index": 43,
      "text": "Depois, sombra novamente, fresca e relaxante.",
      "file": "c043.ogg",
      "durationSec": 6.816
    },
    {
      "index": 44,
      "text": "Sorva chá imaginário. Sinta o calor. Perceba a temperatura da xícara nas palmas.",
      "file": "c044.ogg",
      "durationSec": 10.584
    },
    {
      "index": 45,
      "text": "Fora do jardim, a vida continua. Dentro, o tempo se solta.",
      "file": "c045.ogg",
      "durationSec": 8.472
    },
    {
      "index": 46,
      "text": "Caminhe mais uma vez sob as bambus.",
      "file": "c046.ogg",
      "durationSec": 5.112
    },
    {
      "index": 47,
      "text": "Deixe os talos altos balançarem seu ritmo respiratório, leve e natural.",
      "file": "c047.ogg",
      "durationSec": 8.952
    },
    {
      "index": 48,
      "text": "Uma gota fresca de folha toca seu pulso — uma pequena surpresa refrescante.",
      "file": "c048.ogg",
      "durationSec": 9.216
    },
    {
      "index": 49,
      "text": "Depois, o sol novamente, aquecendo o mesmo lugar até secar.",
      "file": "c049.ogg",
      "durationSec": 7.56
    },
    {
      "index": 50,
      "text": "Você pertence a esta paz enquanto permanecer aqui.",
      "file": "c050.ogg",
      "durationSec": 6.576
    },
    {
      "index": 51,
      "text": "E um fio dela virá com você quando sair.",
      "file": "c051.ogg",
      "durationSec": 5.592
    },
    {
      "index": 52,
      "text": "Sente-se mais uma vez. Mãos abertas sobre os joelhos.",
      "file": "c052.ogg",
      "durationSec": 7.68
    },
    {
      "index": 53,
      "text": "Aquecimento onde a luz toca. Frescor na sombra das bambus.",
      "file": "c053.ogg",
      "durationSec": 8.232
    },
    {
      "index": 54,
      "text": "Inspire o frescor pós-chuva.",
      "file": "c054.ogg",
      "durationSec": 4.56
    },
    {
      "index": 55,
      "text": "Exale para o silêncio arrumado de pedra e cascalho.",
      "file": "c055.ogg",
      "durationSec": 6.648
    },
    {
      "index": 56,
      "text": "Nada afiado permanece. Apenas bordas suaves e ar suficiente.",
      "file": "c056.ogg",
      "durationSec": 8.928
    },
    {
      "index": 57,
      "text": "Retorne ao lago para uma pausa final.",
      "file": "c057.ogg",
      "durationSec": 5.352
    },
    {
      "index": 58,
      "text": "As ondulações de uma gota caída se expandem e desaparecem.",
      "file": "c058.ogg",
      "durationSec": 7.704
    },
    {
      "index": 59,
      "text": "Flechas solares dançam, depois se acalmam.",
      "file": "c059.ogg",
      "durationSec": 5.904
    },
    {
      "index": 60,
      "text": "Aquecimento na bochecha. Frescor de névoa lembrança no nariz.",
      "file": "c060.ogg",
      "durationSec": 8.376
    },
    {
      "index": 61,
      "text": "Incline-se levemente para o jardim — um pequeno aceno interno.",
      "file": "c061.ogg",
      "durationSec": 7.488
    },
    {
      "index": 62,
      "text": "Caminhe mais uma vez sobre as pedras, mais devagar do que antes.",
      "file": "c062.ogg",
      "durationSec": 7.728
    },
    {
      "index": 63,
      "text": "Musgo fresco entre as pedras. Madeira quente da barreira de ponte.",
      "file": "c063.ogg",
      "durationSec": 8.736
    },
    {
      "index": 64,
      "text": "As bambus falam em linguagem de folhas acima.",
      "file": "c064.ogg",
      "durationSec": 6.336
    },
    {
      "index": 65,
      "text": "Você entende o suficiente: permaneça, suavize e continue.",
      "file": "c065.ogg",
      "durationSec": 8.016
    },
    {
      "index": 66,
      "text": "Na fronteira, sinta ambos os mundos — paz do jardim e dia ordinário.",
      "file": "c066.ogg",
      "durationSec": 8.856
    },
    {
      "index": 67,
      "text": "Você pode trançá-los.",
      "file": "c067.ogg",
      "durationSec": 3.984
    },
    {
      "index": 68,
      "text": "Inale frescor para a trança.",
      "file": "c068.ogg",
      "durationSec": 4.464
    },
    {
      "index": 69,
      "text": "Exale calor nas mãos, pronto para encontrar o que vier.",
      "file": "c069.ogg",
      "durationSec": 7.128
    },
    {
      "index": 70,
      "text": "O jardim permanece, quer você esteja olhando ou não.",
      "file": "c070.ogg",
      "durationSec": 6.864
    },
    {
      "index": 71,
      "text": "Agora deixe a história descansar e permaneça com a sensação.",
      "file": "c071.ogg",
      "durationSec": 7.488
    },
    {
      "index": 72,
      "text": "Inale a frescura deste lugar.",
      "file": "c072.ogg",
      "durationSec": 4.608
    },
    {
      "index": 73,
      "text": "Exale em sua calor e quietude.",
      "file": "c073.ogg",
      "durationSec": 4.968
    },
    {
      "index": 74,
      "text": "Inale.",
      "file": "c074.ogg",
      "durationSec": 2.568
    },
    {
      "index": 75,
      "text": "Exale.",
      "file": "c075.ogg",
      "durationSec": 2.592
    },
    {
      "index": 76,
      "text": "Novamente. Inalação suave.",
      "file": "c076.ogg",
      "durationSec": 5.448
    },
    {
      "index": 77,
      "text": "Exalação mais longa.",
      "file": "c077.ogg",
      "durationSec": 3.792
    },
    {
      "index": 78,
      "text": "Sinta o corpo sustentado pelo chão deste mundo imaginário.",
      "file": "c078.ogg",
      "durationSec": 7.44
    },
    {
      "index": 79,
      "text": "Inale.",
      "file": "c079.ogg",
      "durationSec": 2.568
    },
    {
      "index": 80,
      "text": "Exale.",
      "file": "c080.ogg",
      "durationSec": 2.592
    },
    {
      "index": 81,
      "text": "Se os pensamentos vagarem, retorne ao calor na pele.",
      "file": "c081.ogg",
      "durationSec": 6.888
    },
    {
      "index": 82,
      "text": "Ou ao ar fresco no nariz.",
      "file": "c082.ogg",
      "durationSec": 4.32
    },
    {
      "index": 83,
      "text": "Inale.",
      "file": "c083.ogg",
      "durationSec": 2.568
    },
    {
      "index": 84,
      "text": "Exale.",
      "file": "c084.ogg",
      "durationSec": 2.592
    },
    {
      "index": 85,
      "text": "Inale.",
      "file": "c085.ogg",
      "durationSec": 2.568
    },
    {
      "index": 86,
      "text": "Exale.",
      "file": "c086.ogg",
      "durationSec": 2.592
    },
    {
      "index": 87,
      "text": "Permaneça. Amoleça. Continue.",
      "file": "c087.ogg",
      "durationSec": 6.168
    },
    {
      "index": 88,
      "text": "Inale.",
      "file": "c088.ogg",
      "durationSec": 2.568
    },
    {
      "index": 89,
      "text": "Exale.",
      "file": "c089.ogg",
      "durationSec": 2.592
    },
    {
      "index": 90,
      "text": "Mais um ciclo fácil.",
      "file": "c090.ogg",
      "durationSec": 3.816
    },
    {
      "index": 91,
      "text": "Inale.",
      "file": "c091.ogg",
      "durationSec": 2.568
    },
    {
      "index": 92,
      "text": "Exale.",
      "file": "c092.ogg",
      "durationSec": 2.592
    },
    {
      "index": 93,
      "text": "Permaneça nesse sentimento por mais algumas respirações.",
      "file": "c093.ogg",
      "durationSec": 7.32
    },
    {
      "index": 94,
      "text": "Calor. Suavidade. Suficiência.",
      "file": "c094.ogg",
      "durationSec": 6.096
    },
    {
      "index": 95,
      "text": "Você pode voltar a esse lugar sempre que precisar.",
      "file": "c095.ogg",
      "durationSec": 6.384
    },
    {
      "index": 96,
      "text": "Ele vive em sua atenção, não apenas na imaginação.",
      "file": "c096.ogg",
      "durationSec": 6.888
    },
    {
      "index": 97,
      "text": "Comece a aprofundar a respiração.",
      "file": "c097.ogg",
      "durationSec": 4.968
    },
    {
      "index": 98,
      "text": "Sinta novamente o ambiente ao seu redor.",
      "file": "c098.ogg",
      "durationSec": 5.544
    },
    {
      "index": 99,
      "text": "Mova os dedos. Relaxe os dedos dos pés.",
      "file": "c099.ogg",
      "durationSec": 6.744
    },
    {
      "index": 100,
      "text": "Quando estiver pronto, abra os olhos.",
      "file": "c100.ogg",
      "durationSec": 5.424
    },
    {
      "index": 101,
      "text": "Respire mais uma vez com calma.",
      "file": "c101.ogg",
      "durationSec": 4.752
    },
    {
      "index": 102,
      "text": "Leve essa calma para o que vier a seguir.",
      "file": "c102.ogg",
      "durationSec": 5.208
    }
  ]
}
