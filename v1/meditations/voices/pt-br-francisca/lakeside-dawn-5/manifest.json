{
  "id": "lakeside-dawn-5",
  "voiceId": "pt-br-francisca",
  "edgeVoice": "pt-BR-FranciscaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 357,
  "chunks": [
    {
      "index": 0,
      "text": "Bem-vindo.",
      "file": "c000.ogg",
      "durationSec": 2.832
    },
    {
      "index": 1,
      "text": "Assuma uma posição confortável, ou deite-se se isso parecer melhor.",
      "file": "c001.ogg",
      "durationSec": 8.016
    },
    {
      "index": 2,
      "text": "Deixe suas mãos em repouso.",
      "file": "c002.ogg",
      "durationSec": 4.512
    },
    {
      "index": 3,
      "text": "Permita que seus olhos se fechem, ou suavize seu olhar.",
      "file": "c003.ogg",
      "durationSec": 7.056
    },
    {
      "index": 4,
      "text": "Perceba o peso do seu corpo sendo sustentado.",
      "file": "c004.ogg",
      "durationSec": 6.24
    },
    {
      "index": 5,
      "text": "Respire lentamente pelo nariz.",
      "file": "c005.ogg",
      "durationSec": 4.752
    },
    {
      "index": 6,
      "text": "E um suspiro mais longo e fácil para fora.",
      "file": "c006.ogg",
      "durationSec": 5.64
    },
    {
      "index": 7,
      "text": "Novamente. Inalação suave.",
      "file": "c007.ogg",
      "durationSec": 5.448
    },
    {
      "index": 8,
      "text": "Exalação gentil.",
      "file": "c008.ogg",
      "durationSec": 3.624
    },
    {
      "index": 9,
      "text": "Se os pensamentos vagarem, isso está bem. Volte para a respiração.",
      "file": "c009.ogg",
      "durationSec": 8.376
    },
    {
      "index": 10,
      "text": "Imagine-se na beira de um lago calmo ao amanhecer.",
      "file": "c010.ogg",
      "durationSec": 6.648
    },
    {
      "index": 11,
      "text": "A água reflete um céu pálido e prateado.",
      "file": "c011.ogg",
      "durationSec": 5.808
    },
    {
      "index": 12,
      "text": "Ar fresco e limpo toca seu rosto.",
      "file": "c012.ogg",
      "durationSec": 5.016
    },
    {
      "index": 13,
      "text": "Um fino véu de sol começa a aquecer seus ombros.",
      "file": "c013.ogg",
      "durationSec": 6.672
    },
    {
      "index": 14,
      "text": "Sinta essa calor se espalhando lentamente por sua costas.",
      "file": "c014.ogg",
      "durationSec": 7.44
    },
    {
      "index": 15,
      "text": "Você avança um passo. Areia macia cede sob seus pés.",
      "file": "c015.ogg",
      "durationSec": 7.992
    },
    {
      "index": 16,
      "text": "Mergulhe os dedos nos dedos na água. Fria. Clara.",
      "file": "c016.ogg",
      "durationSec": 7.92
    },
    {
      "index": 17,
      "text": "Ondas se espalham e desaparecem.",
      "file": "c017.ogg",
      "durationSec": 4.968
    },
    {
      "index": 18,
      "text": "A brisa cheira levemente a plantas aquáticas e manhã.",
      "file": "c018.ogg",
      "durationSec": 6.936
    },
    {
      "index": 19,
      "text": "Escute. Quase nada. Um pássaro distante. Sua própria respiração.",
      "file": "c019.ogg",
      "durationSec": 10.056
    },
    {
      "index": 20,
      "text": "Sente-se em uma pedra lisa aquecida apenas o suficiente pela luz que nasce.",
      "file": "c020.ogg",
      "durationSec": 9.096
    },
    {
      "index": 21,
      "text": "Sinta o calor quieto da pedra sob você.",
      "file": "c021.ogg",
      "durationSec": 6.024
    },
    {
      "index": 22,
      "text": "Sinta a frescor do ar entrando em seus pulmões.",
      "file": "c022.ogg",
      "durationSec": 6.216
    },
    {
      "index": 23,
      "text": "O lago reflete tons suaves de rosa e ouro.",
      "file": "c023.ogg",
      "durationSec": 6.288
    },
    {
      "index": 24,
      "text": "Você observa a luz se mover pela superfície como uma respiração lenta.",
      "file": "c024.ogg",
      "durationSec": 8.544
    },
    {
      "index": 25,
      "text": "Um peixe sobe, os círculos se abrem e o espelho retorna.",
      "file": "c025.ogg",
      "durationSec": 7.368
    },
    {
      "index": 26,
      "text": "Calor em seus olhos fechados.",
      "file": "c026.ogg",
      "durationSec": 4.656
    },
    {
      "index": 27,
      "text": "Frio nas costas das mãos.",
      "file": "c027.ogg",
      "durationSec": 4.392
    },
    {
      "index": 28,
      "text": "Algo distante, uma corda de barco bate uma vez contra a madeira.",
      "file": "c028.ogg",
      "durationSec": 8.016
    },
    {
      "index": 29,
      "text": "Então silêncio novamente, amplo e gentil.",
      "file": "c029.ogg",
      "durationSec": 6.096
    },
    {
      "index": 30,
      "text": "Inale a manhã fresca. Exale para a água aberta.",
      "file": "c030.ogg",
      "durationSec": 7.008
    },
    {
      "index": 31,
      "text": "A paz se instala como a névoa se levanta da água — suavemente, completamente.",
      "file": "c031.ogg",
      "durationSec": 9.504
    },
    {
      "index": 32,
      "text": "Você tem permissão para ocupar espaço neste silêncio.",
      "file": "c032.ogg",
      "durationSec": 6.816
    },
    {
      "index": 33,
      "text": "Mais uma respiração com sabor de alvorecer.",
      "file": "c033.ogg",
      "durationSec": 5.952
    },
    {
      "index": 34,
      "text": "Olhe novamente para a trilha prateada de luz na água.",
      "file": "c034.ogg",
      "durationSec": 6.696
    },
    {
      "index": 35,
      "text": "Siga-a com olhos suaves em direção à margem distante.",
      "file": "c035.ogg",
      "durationSec": 7.44
    },
    {
      "index": 36,
      "text": "As árvores ali estão azuis pela distância e pela névoa da manhã.",
      "file": "c036.ogg",
      "durationSec": 7.92
    },
    {
      "index": 37,
      "text": "O calor cresce um pouco nos seus ombros à medida que o sol sobe.",
      "file": "c037.ogg",
      "durationSec": 7.824
    },
    {
      "index": 38,
      "text": "A brisa permanece fresca — nascida do lago e pura.",
      "file": "c038.ogg",
      "durationSec": 6.864
    },
    {
      "index": 39,
      "text": "Deixe essa frescura lavar a mente como a luz lava a superfície.",
      "file": "c039.ogg",
      "durationSec": 7.608
    },
    {
      "index": 40,
      "text": "Sente-se por mais três respirações de calor e ar fresco juntos.",
      "file": "c040.ogg",
      "durationSec": 7.992
    },
    {
      "index": 41,
      "text": "Agora repouse apenas na respiração por um tempo.",
      "file": "c041.ogg",
      "durationSec": 6.384
    },
    {
      "index": 42,
      "text": "Inspire lentamente.",
      "file": "c042.ogg",
      "durationSec": 3.888
    },
    {
      "index": 43,
      "text": "Exale lentamente.",
      "file": "c043.ogg",
      "durationSec": 3.792
    },
    {
      "index": 44,
      "text": "Inspire.",
      "file": "c044.ogg",
      "durationSec": 2.64
    },
    {
      "index": 45,
      "text": "Exale.",
      "file": "c045.ogg",
      "durationSec": 2.592
    },
    {
      "index": 46,
      "text": "Sinta o calor onde quer que o corpo esteja quente.",
      "file": "c046.ogg",
      "durationSec": 6.504
    },
    {
      "index": 47,
      "text": "Sinta a frescura onde quer que o ar esteja frio.",
      "file": "c047.ogg",
      "durationSec": 6.312
    },
    {
      "index": 48,
      "text": "Inspire.",
      "file": "c048.ogg",
      "durationSec": 2.64
    },
    {
      "index": 49,
      "text": "Exale.",
      "file": "c049.ogg",
      "durationSec": 2.592
    },
    {
      "index": 50,
      "text": "Nenhum lugar para ir. Nada para consertar.",
      "file": "c050.ogg",
      "durationSec": 6.432
    },
    {
      "index": 51,
      "text": "Inspire.",
      "file": "c051.ogg",
      "durationSec": 2.64
    },
    {
      "index": 52,
      "text": "Exale.",
      "file": "c052.ogg",
      "durationSec": 2.592
    },
    {
      "index": 53,
      "text": "Repouse aqui por algumas respirações tranquilas.",
      "file": "c053.ogg",
      "durationSec": 6.456
    },
    {
      "index": 54,
      "text": "Saiba que você pode voltar a este lugar a qualquer momento.",
      "file": "c054.ogg",
      "durationSec": 7.08
    },
    {
      "index": 55,
      "text": "Quando estiver pronto, aprofunde a respiração.",
      "file": "c055.ogg",
      "durationSec": 5.856
    },
    {
      "index": 56,
      "text": "Mova os dedos das mãos e dos pés.",
      "file": "c056.ogg",
      "durationSec": 5.352
    },
    {
      "index": 57,
      "text": "Abra os olhos suavemente.",
      "file": "c057.ogg",
      "durationSec": 4.224
    },
    {
      "index": 58,
      "text": "Leve um pouco dessa paz com você.",
      "file": "c058.ogg",
      "durationSec": 4.8
    }
  ]
}
