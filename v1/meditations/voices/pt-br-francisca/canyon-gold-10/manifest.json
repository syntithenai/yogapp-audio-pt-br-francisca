{
  "id": "canyon-gold-10",
  "voiceId": "pt-br-francisca",
  "edgeVoice": "pt-BR-FranciscaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 616,
  "chunks": [
    {
      "index": 0,
      "text": "Bem-vindo.",
      "file": "c000.ogg",
      "durationSec": 2.832
    },
    {
      "index": 1,
      "text": "Encontre uma postura que não exija nada de você.",
      "file": "c001.ogg",
      "durationSec": 6.216
    },
    {
      "index": 2,
      "text": "Sente-se ou deite-se, com o apoio que precisar.",
      "file": "c002.ogg",
      "durationSec": 5.904
    },
    {
      "index": 3,
      "text": "Deixe as mãos repousar abertas ou relaxadas.",
      "file": "c003.ogg",
      "durationSec": 6.288
    },
    {
      "index": 4,
      "text": "Permita que os olhos se fechem, ou mantenha um olhar suave.",
      "file": "c004.ogg",
      "durationSec": 7.44
    },
    {
      "index": 5,
      "text": "Sinta os pontos onde seu corpo encontra o chão.",
      "file": "c005.ogg",
      "durationSec": 6.408
    },
    {
      "index": 6,
      "text": "Os calcanhares, os ossos do cóccix, a parte de trás da cabeça ou o comprimento da coluna.",
      "file": "c006.ogg",
      "durationSec": 11.04
    },
    {
      "index": 7,
      "text": "Nada para sustentar agora.",
      "file": "c007.ogg",
      "durationSec": 4.392
    },
    {
      "index": 8,
      "text": "Respire lentamente pelo nariz.",
      "file": "c008.ogg",
      "durationSec": 4.752
    },
    {
      "index": 9,
      "text": "Sinta a frescura do ar chegando.",
      "file": "c009.ogg",
      "durationSec": 4.944
    },
    {
      "index": 10,
      "text": "E expire um pouco mais longo.",
      "file": "c010.ogg",
      "durationSec": 3.936
    },
    {
      "index": 11,
      "text": "Sinta o calor da expiração saindo.",
      "file": "c011.ogg",
      "durationSec": 5.424
    },
    {
      "index": 12,
      "text": "Novamente. Inalação suave.",
      "file": "c012.ogg",
      "durationSec": 5.448
    },
    {
      "index": 13,
      "text": "Exalação tranquila.",
      "file": "c013.ogg",
      "durationSec": 3.816
    },
    {
      "index": 14,
      "text": "Deixe os ombros baixarem um pouco.",
      "file": "c014.ogg",
      "durationSec": 5.112
    },
    {
      "index": 15,
      "text": "Relaxe a mandíbula.",
      "file": "c015.ogg",
      "durationSec": 3.768
    },
    {
      "index": 16,
      "text": "Deixe a barriga ser macia.",
      "file": "c016.ogg",
      "durationSec": 4.512
    },
    {
      "index": 17,
      "text": "Permaneça com três respirações tranquilas, exatamente como elas são.",
      "file": "c017.ogg",
      "durationSec": 8.88
    },
    {
      "index": 18,
      "text": "Inale. Chegue.",
      "file": "c018.ogg",
      "durationSec": 4.08
    },
    {
      "index": 19,
      "text": "Exale. Acomode-se.",
      "file": "c019.ogg",
      "durationSec": 4.536
    },
    {
      "index": 20,
      "text": "Se a mente se desviar, perceba com gentileza e volte a esta respiração.",
      "file": "c020.ogg",
      "durationSec": 9.216
    },
    {
      "index": 21,
      "text": "Imagine um vasto cânion pintado em dourado suave e rosa.",
      "file": "c021.ogg",
      "durationSec": 7.704
    },
    {
      "index": 22,
      "text": "É fim de tarde. A luz é generosa.",
      "file": "c022.ogg",
      "durationSec": 6.072
    },
    {
      "index": 23,
      "text": "O calor irradia da pedra que guardou o sol o dia inteiro.",
      "file": "c023.ogg",
      "durationSec": 7.224
    },
    {
      "index": 24,
      "text": "Sinta esse calor radiante em suas canelas e nas costas das mãos.",
      "file": "c024.ogg",
      "durationSec": 8.424
    },
    {
      "index": 25,
      "text": "Uma brisa seca e fresca move-se pelo fundo do cânion.",
      "file": "c025.ogg",
      "durationSec": 6.984
    },
    {
      "index": 26,
      "text": "Ela refresca seu rosto sem tirar o conforto do calor.",
      "file": "c026.ogg",
      "durationSec": 7.008
    },
    {
      "index": 27,
      "text": "Você caminha por um caminho arenoso entre paredes silenciosas.",
      "file": "c027.ogg",
      "durationSec": 7.68
    },
    {
      "index": 28,
      "text": "Passos sussurram. Os ecos são suaves, quase educados.",
      "file": "c028.ogg",
      "durationSec": 7.872
    },
    {
      "index": 29,
      "text": "Sinta o cheiro da terra ensolarada, sálvia e poeira limpa.",
      "file": "c029.ogg",
      "durationSec": 7.776
    },
    {
      "index": 30,
      "text": "Coloque sua palma na pedra lisa.",
      "file": "c030.ogg",
      "durationSec": 4.848
    },
    {
      "index": 31,
      "text": "Sinta a luz do dia armazenada ali — calor constante e paciente.",
      "file": "c031.ogg",
      "durationSec": 8.4
    },
    {
      "index": 32,
      "text": "Uma faixa de sombra oferece frescor por alguns passos.",
      "file": "c032.ogg",
      "durationSec": 6.984
    },
    {
      "index": 33,
      "text": "Então sol novamente, quente sobre seus ombros como um xale.",
      "file": "c033.ogg",
      "durationSec": 7.512
    },
    {
      "index": 34,
      "text": "Você chega a um lugar onde o cânion se abre.",
      "file": "c034.ogg",
      "durationSec": 5.64
    },
    {
      "index": 35,
      "text": "Sente-se em uma pedra plana ainda mantendo calor dourado.",
      "file": "c035.ogg",
      "durationSec": 7.08
    },
    {
      "index": 36,
      "text": "Sinta-o subir através de sua bunda e coluna.",
      "file": "c036.ogg",
      "durationSec": 6.336
    },
    {
      "index": 37,
      "text": "Sinta o ar mais fresco da altitude em cada inspiração.",
      "file": "c037.ogg",
      "durationSec": 7.248
    },
    {
      "index": 38,
      "text": "Muito acima, um falcão gira em círculos lentos sem pressa.",
      "file": "c038.ogg",
      "durationSec": 7.488
    },
    {
      "index": 39,
      "text": "Você empresta essa qualidade de calma.",
      "file": "c039.ogg",
      "durationSec": 5.184
    },
    {
      "index": 40,
      "text": "Respire longo. Corpo pesado. Mente ampla como o céu entre as paredes.",
      "file": "c040.ogg",
      "durationSec": 9.792
    },
    {
      "index": 41,
      "text": "Observe a sombra subir pela encosta distante enquanto o sol se põe.",
      "file": "c041.ogg",
      "durationSec": 8.424
    },
    {
      "index": 42,
      "text": "As cores se aprofundam. O calor suaviza, mas não desaparece.",
      "file": "c042.ogg",
      "durationSec": 8.376
    },
    {
      "index": 43,
      "text": "A brisa agora tem cheiro mais fresco, de noite.",
      "file": "c043.ogg",
      "durationSec": 6.336
    },
    {
      "index": 44,
      "text": "Envolva-se em seus braços por um momento.",
      "file": "c044.ogg",
      "durationSec": 5.496
    },
    {
      "index": 45,
      "text": "Calor do seu próprio corpo. Calor da pedra. Bastante.",
      "file": "c045.ogg",
      "durationSec": 8.232
    },
    {
      "index": 46,
      "text": "Deite-se com cuidado e observe a primeira estrela tranquila.",
      "file": "c046.ogg",
      "durationSec": 7.344
    },
    {
      "index": 47,
      "text": "O cânion o sustenta como uma mão aberta sustenta água — suavemente, sem derramar.",
      "file": "c047.ogg",
      "durationSec": 9.6
    },
    {
      "index": 48,
      "text": "Descanse nesse sentimento de sustentação.",
      "file": "c048.ogg",
      "durationSec": 5.88
    },
    {
      "index": 49,
      "text": "Perceba o último calor subindo da rocha para o ar fresco.",
      "file": "c049.ogg",
      "durationSec": 7.272
    },
    {
      "index": 50,
      "text": "Perceba como a brisa agora tem cheiro de noite, poeira e sálvia.",
      "file": "c050.ogg",
      "durationSec": 7.752
    },
    {
      "index": 51,
      "text": "Sua respiração diminuiu para combinar com o silêncio amplo.",
      "file": "c051.ogg",
      "durationSec": 7.488
    },
    {
      "index": 52,
      "text": "Se houver tensão na testa, suavize-a nesta luz dourada.",
      "file": "c052.ogg",
      "durationSec": 7.128
    },
    {
      "index": 53,
      "text": "Se a mandíbula estiver tensa, deixe-a relaxar como a curva fácil da falcão.",
      "file": "c053.ogg",
      "durationSec": 9.312
    },
    {
      "index": 54,
      "text": "Permaneça por mais alguns ciclos de pedra quente e ar fresco.",
      "file": "c054.ogg",
      "durationSec": 7.512
    },
    {
      "index": 55,
      "text": "Você não está atrasado. Você está aqui.",
      "file": "c055.ogg",
      "durationSec": 5.976
    },
    {
      "index": 56,
      "text": "Ande mais alguns passos sobre a areia quente entre as paredes do cânion.",
      "file": "c056.ogg",
      "durationSec": 8.136
    },
    {
      "index": 57,
      "text": "Sua sombra se estende longa e despreocupada.",
      "file": "c057.ogg",
      "durationSec": 6.24
    },
    {
      "index": 58,
      "text": "Coloque ambas as palmas na pedra novamente.",
      "file": "c058.ogg",
      "durationSec": 6.24
    },
    {
      "index": 59,
      "text": "O calor entra nas mãos como uma bênção que você não precisa merecer.",
      "file": "c059.ogg",
      "durationSec": 7.944
    },
    {
      "index": 60,
      "text": "A brisa passa com frescor pelos seus cabelos.",
      "file": "c060.ogg",
      "durationSec": 6.0
    },
    {
      "index": 61,
      "text": "Cheiro de sálvia. Cheiro de poeira. Cheiro de sol.",
      "file": "c061.ogg",
      "durationSec": 8.016
    },
    {
      "index": 62,
      "text": "Sente-se. Joelhos relaxados. Coluna confortável.",
      "file": "c062.ogg",
      "durationSec": 8.16
    },
    {
      "index": 63,
      "text": "Observe a cor se aprofundar do dourado para o rosa.",
      "file": "c063.ogg",
      "durationSec": 6.696
    },
    {
      "index": 64,
      "text": "O calor suaviza. A frescura aumenta. O equilíbrio permanece.",
      "file": "c064.ogg",
      "durationSec": 8.808
    },
    {
      "index": 65,
      "text": "É assim que as tardes ensinam o sistema nervoso a desacelerar.",
      "file": "c065.ogg",
      "durationSec": 7.776
    },
    {
      "index": 66,
      "text": "Aprenda a lição sem esforço.",
      "file": "c066.ogg",
      "durationSec": 4.632
    },
    {
      "index": 67,
      "text": "Três respirações para a pedra.",
      "file": "c067.ogg",
      "durationSec": 4.608
    },
    {
      "index": 68,
      "text": "Três para o céu.",
      "file": "c068.ogg",
      "durationSec": 3.24
    },
    {
      "index": 69,
      "text": "Três para o animal silencioso do seu próprio corpo, descansando.",
      "file": "c069.ogg",
      "durationSec": 8.04
    },
    {
      "index": 70,
      "text": "Agora deixe a história descansar e permaneça com a sensação.",
      "file": "c070.ogg",
      "durationSec": 7.488
    },
    {
      "index": 71,
      "text": "Inspire a frescura deste lugar.",
      "file": "c071.ogg",
      "durationSec": 4.584
    },
    {
      "index": 72,
      "text": "Exale para o seu calor e quietude.",
      "file": "c072.ogg",
      "durationSec": 5.136
    },
    {
      "index": 73,
      "text": "Inspira.",
      "file": "c073.ogg",
      "durationSec": 2.64
    },
    {
      "index": 74,
      "text": "Exala.",
      "file": "c074.ogg",
      "durationSec": 2.592
    },
    {
      "index": 75,
      "text": "Mais uma vez. Inspira suavemente.",
      "file": "c075.ogg",
      "durationSec": 5.952
    },
    {
      "index": 76,
      "text": "Exale mais longamente.",
      "file": "c076.ogg",
      "durationSec": 4.224
    },
    {
      "index": 77,
      "text": "Sinta o corpo sustentado pelo chão deste mundo imaginado.",
      "file": "c077.ogg",
      "durationSec": 7.512
    },
    {
      "index": 78,
      "text": "Inspira.",
      "file": "c078.ogg",
      "durationSec": 2.64
    },
    {
      "index": 79,
      "text": "Exala.",
      "file": "c079.ogg",
      "durationSec": 2.592
    },
    {
      "index": 80,
      "text": "Se os pensamentos vagarem, volte para o calor na pele.",
      "file": "c080.ogg",
      "durationSec": 6.936
    },
    {
      "index": 81,
      "text": "Ou ao ar frio no nariz.",
      "file": "c081.ogg",
      "durationSec": 4.128
    },
    {
      "index": 82,
      "text": "Inspira.",
      "file": "c082.ogg",
      "durationSec": 2.64
    },
    {
      "index": 83,
      "text": "Exala.",
      "file": "c083.ogg",
      "durationSec": 2.592
    },
    {
      "index": 84,
      "text": "Inspira.",
      "file": "c084.ogg",
      "durationSec": 2.64
    },
    {
      "index": 85,
      "text": "Exala.",
      "file": "c085.ogg",
      "durationSec": 2.592
    },
    {
      "index": 86,
      "text": "Permaneça. Suavize. Continue.",
      "file": "c086.ogg",
      "durationSec": 6.36
    },
    {
      "index": 87,
      "text": "Inspira.",
      "file": "c087.ogg",
      "durationSec": 2.64
    },
    {
      "index": 88,
      "text": "Exala.",
      "file": "c088.ogg",
      "durationSec": 2.592
    },
    {
      "index": 89,
      "text": "Mais um ciclo fácil.",
      "file": "c089.ogg",
      "durationSec": 3.816
    },
    {
      "index": 90,
      "text": "Inspira.",
      "file": "c090.ogg",
      "durationSec": 2.64
    },
    {
      "index": 91,
      "text": "Exala.",
      "file": "c091.ogg",
      "durationSec": 2.592
    },
    {
      "index": 92,
      "text": "Permaneça nesse sentimento por mais algumas respirações.",
      "file": "c092.ogg",
      "durationSec": 7.32
    },
    {
      "index": 93,
      "text": "Calor. Maciez. Suficiência.",
      "file": "c093.ogg",
      "durationSec": 6.024
    },
    {
      "index": 94,
      "text": "Você pode retornar a este lugar sempre que precisar.",
      "file": "c094.ogg",
      "durationSec": 6.744
    },
    {
      "index": 95,
      "text": "Ele vive em sua atenção, não apenas na imaginação.",
      "file": "c095.ogg",
      "durationSec": 6.888
    },
    {
      "index": 96,
      "text": "Comece a aprofundar a respiração.",
      "file": "c096.ogg",
      "durationSec": 4.968
    },
    {
      "index": 97,
      "text": "Sinta novamente o ambiente ao seu redor.",
      "file": "c097.ogg",
      "durationSec": 5.544
    },
    {
      "index": 98,
      "text": "Mova os dedos. Relaxe os dedos dos pés.",
      "file": "c098.ogg",
      "durationSec": 6.744
    },
    {
      "index": 99,
      "text": "Quando estiver pronto, abra os olhos.",
      "file": "c099.ogg",
      "durationSec": 5.424
    },
    {
      "index": 100,
      "text": "Respire mais uma vez com calma.",
      "file": "c100.ogg",
      "durationSec": 4.752
    },
    {
      "index": 101,
      "text": "Leve essa calma para o que vier a seguir.",
      "file": "c101.ogg",
      "durationSec": 5.208
    }
  ]
}
