  "totalSec": 169,
  "chunks": [
    {
      "index": 0,
      "text": "Bem-vindo.",
      "file": "c000.ogg",
      "durationSec": 2.832
    },
    {
      "index": 1,
      "text": "Tome tempo para chegar.",
      "file": "c001.ogg",
      "durationSec": 3.768
    },
    {
      "index": 2,
      "text": "Sente-se ou deite-se com apoio.",
      "file": "c002.ogg",
      "durationSec": 4.728
    },
    {
      "index": 3,
      "text": "Feche os olhos se isso parecer seguro.",
      "file": "c003.ogg",
      "durationSec": 5.448
    },
    {
      "index": 4,
      "text": "Sinta o contato com o chão.",
      "file": "c004.ogg",
      "durationSec": 4.416
    },
    {
      "index": 5,
      "text": "Respiração lenta e profunda.",
      "file": "c005.ogg",
      "durationSec": 4.56
    },
    {
      "index": 6,
      "text": "Respiração longa e lenta.",
      "file": "c006.ogg",
      "durationSec": 4.392
    },
    {
      "index": 7,
      "text": "[pausa:28]",
      "file": "c007.ogg",
      "durationSec": 3.888
    },
    {
      "index": 8,
      "text": "Mais uma vez.",
      "file": "c008.ogg",
      "durationSec": 3.288
    },
    {
      "index": 9,
      "text": "[pausa:28]",
      "file": "c009.ogg",
      "durationSec": 3.888
    },
    {
      "index": 10,
      "text": "Deixe os ombros baixarem.",
      "file": "c010.ogg",
      "durationSec": 4.344
    },
    {
      "index": 11,
      "text": "Deixe a barriga relaxar.",
      "file": "c011.ogg",
      "durationSec": 4.176
    },
    {
      "index": 12,
      "text": "[pausa:36]",
      "file": "c012.ogg",
      "durationSec": 4.152
    },
    {
      "index": 13,
      "text": "Imagine-se como uma montanha.",
      "file": "c013.ogg",
      "durationSec": 4.608
    },
    {
      "index": 14,
      "text": "Base larga. Pico tranquilo. Paciência vasta.",
      "file": "c014.ogg",
      "durationSec": 7.464
    },
    {
      "index": 15,
      "text": "[pausa:43]",
      "file": "c015.ogg",
      "durationSec": 4.224
    },
    {
      "index": 16,
      "text": "O tempo passa sobre a montanha.",
      "file": "c016.ogg",
      "durationSec": 4.632
    },
    {
      "index": 17,
      "text": "Sol. Vento. Nuvem. Tempestade.",
      "file": "c017.ogg",
      "durationSec": 7.08
    },
    {
      "index": 18,
      "text": "A montanha permanece.",
      "file": "c018.ogg",
      "durationSec": 3.912
    },
    {
      "index": 19,
      "text": "[pausa:57]",
      "file": "c019.ogg",
      "durationSec": 4.512
    },
    {
      "index": 20,
      "text": "Pensamentos e estados de espírito são o tempo.",
      "file": "c020.ogg",
      "durationSec": 6.216
    },
    {
      "index": 21,
      "text": "Você é a montanha.",
      "file": "c021.ogg",
      "durationSec": 3.456
    },
    {
      "index": 22,
      "text": "[pausa:57]",
      "file": "c022.ogg",
      "durationSec": 4.512
    },
    {
      "index": 23,
      "text": "Sinta a base do seu corpo enraizada.",
      "file": "c023.ogg",
      "durationSec": 5.496
    },
    {
      "index": 24,
      "text": "Sinta a altura na coluna sem tensão.",
      "file": "c024.ogg",
      "durationSec": 5.424
    },
    {
      "index": 25,
      "text": "[pausa:43]",
      "file": "c025.ogg",
      "durationSec": 4.224
    },
    {
      "index": 26,
      "text": "Respire como o céu ao redor da montanha.",
      "file": "c026.ogg",
      "durationSec": 5.736
    },
    {
      "index": 27,
      "text": "[pausa:71]",
      "file": "c027.ogg",
      "durationSec": 3.888
    },
    {
      "index": 28,
      "text": "Estável. Sem pressa. O suficiente.",
      "file": "c028.ogg",
      "durationSec": 6.648
    },
    {
      "index": 29,
      "text": "[pausa:90]",
      "file": "c029.ogg",
      "durationSec": 3.6
    },
    {
      "index": 30,
      "text": "[pausa:43]",
      "file": "c030.ogg",
      "durationSec": 4.224
    },
    {
      "index": 31,
      "text": "Comece a aprofundar a respiração.",
      "file": "c031.ogg",
      "durationSec": 4.968
    },
    {
      "index": 32,
      "text": "Sinta novamente o ambiente.",
      "file": "c032.ogg",
      "durationSec": 4.632
    },
    {
      "index": 33,
      "text": "Mova os dedos das mãos e dos pés.",
      "file": "c033.ogg",
      "durationSec": 5.352
    },
    {
      "index": 34,
      "text": "Quando estiver pronto, abra os olhos.",
      "file": "c034.ogg",
      "durationSec": 5.424
    },
    {
      "index": 35,
      "text": "Mova-se lentamente para o que vem a seguir.",
      "file": "c035.ogg",
      "durationSec": 5.376
    }
  ]
}
