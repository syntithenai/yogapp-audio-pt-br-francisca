{
  "id": "anxiety-ease-10",
  "voiceId": "pt-br-francisca",
  "edgeVoice": "pt-BR-FranciscaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 245,
  "chunks": [
    {
      "index": 0,
      "text": "Bem-vindo.",
      "file": "c000.ogg",
      "durationSec": 2.832
    },
    {
      "index": 1,
      "text": "Preste atenção para chegar aqui.",
      "file": "c001.ogg",
      "durationSec": 4.632
    },
    {
      "index": 2,
      "text": "Sente-se ou deite com suporte.",
      "file": "c002.ogg",
      "durationSec": 4.896
    },
    {
      "index": 3,
      "text": "Feche os olhos se isso parecer seguro.",
      "file": "c003.ogg",
      "durationSec": 5.448
    },
    {
      "index": 4,
      "text": "Sinta o contato com o chão.",
      "file": "c004.ogg",
      "durationSec": 4.416
    },
    {
      "index": 5,
      "text": "Respiração lenta pela entrada.",
      "file": "c005.ogg",
      "durationSec": 4.68
    },
    {
      "index": 6,
      "text": "Respiração mais longa pela saída.",
      "file": "c006.ogg",
      "durationSec": 5.088
    },
    {
      "index": 7,
      "text": "[pausa:20]",
      "file": "c007.ogg",
      "durationSec": 3.432
    },
    {
      "index": 8,
      "text": "Mais uma vez.",
      "file": "c008.ogg",
      "durationSec": 3.288
    },
    {
      "index": 9,
      "text": "[pausa:20]",
      "file": "c009.ogg",
      "durationSec": 3.432
    },
    {
      "index": 10,
      "text": "Deixe os ombros cair.",
      "file": "c010.ogg",
      "durationSec": 3.84
    },
    {
      "index": 11,
      "text": "Deixe o abdome se suavizar.",
      "file": "c011.ogg",
      "durationSec": 4.536
    },
    {
      "index": 12,
      "text": "[pausa:25]",
      "file": "c012.ogg",
      "durationSec": 4.008
    },
    {
      "index": 13,
      "text": "A ansiedade pode ainda estar aqui. Isso é permitido.",
      "file": "c013.ogg",
      "durationSec": 7.248
    },
    {
      "index": 14,
      "text": "Nós não estamos combatendo isso. Estamos nos tornando amigos do corpo.",
      "file": "c014.ogg",
      "durationSec": 8.568
    },
    {
      "index": 15,
      "text": "[pausa:25]",
      "file": "c015.ogg",
      "durationSec": 4.008
    },
    {
      "index": 16,
      "text": "Pressione os pés levemente no chão.",
      "file": "c016.ogg",
      "durationSec": 5.16
    },
    {
      "index": 17,
      "text": "Sinta o chão empurrando de volta.",
      "file": "c017.ogg",
      "durationSec": 5.184
    },
    {
      "index": 18,
      "text": "[pausa:25]",
      "file": "c018.ogg",
      "durationSec": 4.008
    },
    {
      "index": 19,
      "text": "Nomeie três coisas que pode ver com os olhos fechados, ou com um olhar suave.",
      "file": "c019.ogg",
      "durationSec": 9.096
    },
    {
      "index": 20,
      "text": "Escuro. Luz. Forma das pálpebras.",
      "file": "c020.ogg",
      "durationSec": 6.504
    },
    {
      "index": 21,
      "text": "[pausa:25]",
      "file": "c021.ogg",
      "durationSec": 4.008
    },
    {
      "index": 22,
      "text": "Nomeie três sensações.",
      "file": "c022.ogg",
      "durationSec": 4.488
    },
    {
      "index": 23,
      "text": "Roupas. Temperatura. Respiração.",
      "file": "c023.ogg",
      "durationSec": 6.552
    },
    {
      "index": 24,
      "text": "[pausa:25]",
      "file": "c024.ogg",
      "durationSec": 4.008
    },
    {
      "index": 25,
      "text": "Inspire por quatro.",
      "file": "c025.ogg",
      "durationSec": 3.552
    },
    {
      "index": 26,
      "text": "Segure por dois.",
      "file": "c026.ogg",
      "durationSec": 3.72
    },
    {
      "index": 27,
      "text": "Exale por seis.",
      "file": "c027.ogg",
      "durationSec": 3.456
    },
    {
      "index": 28,
      "text": "[pausa:20]",
      "file": "c028.ogg",
      "durationSec": 3.432
    },
    {
      "index": 29,
      "text": "Novamente.",
      "file": "c029.ogg",
      "durationSec": 3.024
    },
    {
      "index": 30,
      "text": "[pausa:25]",
      "file": "c030.ogg",
      "durationSec": 4.008
    },
    {
      "index": 31,
      "text": "Coloque uma mão no peito ou no abdome.",
      "file": "c031.ogg",
      "durationSec": 5.424
    },
    {
      "index": 32,
      "text": "Sinta o movimento sob a mão.",
      "file": "c032.ogg",
      "durationSec": 4.656
    },
    {
      "index": 33,
      "text": "Diga em voz baixa: neste exato momento, estou respirando.",
      "file": "c033.ogg",
      "durationSec": 7.368
    },
    {
      "index": 34,
      "text": "[pausa:30]",
      "file": "c034.ogg",
      "durationSec": 3.432
    },
    {
      "index": 35,
      "text": "Se a mente correr adiante, agradeça por tentar protegê-lo.",
      "file": "c035.ogg",
      "durationSec": 7.416
    },
    {
      "index": 36,
      "text": "Então retorne a esta respiração.",
      "file": "c036.ogg",
      "durationSec": 5.04
    },
    {
      "index": 37,
      "text": "[pausa:41]",
      "file": "c037.ogg",
      "durationSec": 3.792
    },
    {
      "index": 38,
      "text": "Varra o rosto. Amoleça.",
      "file": "c038.ogg",
      "durationSec": 4.752
    },
    {
      "index": 39,
      "text": "Varra as mãos. Amoleça.",
      "file": "c039.ogg",
      "durationSec": 4.752
    },
    {
      "index": 40,
      "text": "[pausa:30]",
      "file": "c040.ogg",
      "durationSec": 3.432
    },
    {
      "index": 41,
      "text": "Descanse no ritmo das expirações mais longas.",
      "file": "c041.ogg",
      "durationSec": 6.48
    },
    {
      "index": 42,
      "text": "[pausa:76]",
      "file": "c042.ogg",
      "durationSec": 4.248
    },
    {
      "index": 43,
      "text": "Você deu ao sistema nervoso uma margem mais ampla.",
      "file": "c043.ogg",
      "durationSec": 6.648
    },
    {
      "index": 44,
      "text": "[pausa:41]",
      "file": "c044.ogg",
      "durationSec": 3.792
    },
    {
      "index": 45,
      "text": "[pausa:30]",
      "file": "c045.ogg",
      "durationSec": 3.432
    },
    {
      "index": 46,
      "text": "Comece a aprofundar a respiração.",
      "file": "c046.ogg",
      "durationSec": 4.968
    },
    {
      "index": 47,
      "text": "Sinta novamente o ambiente.",
      "file": "c047.ogg",
      "durationSec": 4.632
    },
    {
      "index": 48,
      "text": "Mova os dedos das mãos e dos pés.",
      "file": "c048.ogg",
      "durationSec": 5.352
    },
    {
      "index": 49,
      "text": "Quando estiver pronto, abra os olhos.",
      "file": "c049.ogg",
      "durationSec": 5.424
    },
    {
      "index": 50,
      "text": "Mova-se lentamente para o que vier a seguir.",
      "file": "c050.ogg",
      "durationSec": 5.568
    }
  ]
}
